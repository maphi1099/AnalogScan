# AutoNeg – C++23 / CMake / vcpkg / clang

# Build-Verzeichnisse (alle Presets bauen nach build/<preset>)
/build/
/out/
cmake-build-*/

# CMake
CMakeUserPresets.json
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/Temporary/
compile_commands.json

# vcpkg (Manifest-Modus)
vcpkg_installed/
/vcpkg/

# Compiler- und Linker-Ausgaben
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dll
*.exe
*.pdb
*.ilk
*.exp
*.dSYM/
*.gcda
*.gcno
*.profraw
*.profdata

# clangd
.cache/
.clangd/

# Editoren und IDEs: nur die gemeinsam genutzten VS-Code-Einstellungen einchecken
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.vs/
*.swp
*~
.DS_Store
Thumbs.db

# Python-Testwerkzeuge (tools/, tests/)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Große Bild- und RAW-Dateien gehören nicht ins Repository
# (Testdaten liegen außerhalb unter ../Testing/Data, synthetische Bilder entstehen per Code)
*.ARW
*.arw
*.RAF
*.raf
*.3FR
*.3fr
*.FFF
*.fff
*.NEF
*.nef
*.CR2
*.cr2
*.CR3
*.cr3
*.RW2
*.ORF
*.PEF
*.RWL
*.IIQ

# Laufzeitdateien der Anwendung, falls lokal im Repository getestet
*.autoneg.json.tmp
*.autoneg.json.defekt
.autoneg.lock
*.log

# Ausnahme: 1-KB-Textdatei mit RAW-Endung für K-03 (keine echte RAW-Datei)
!tests/component/data/not_a_raw.ARW

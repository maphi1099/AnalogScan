{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "autoneg",
  "version": "1.0.0",
  "description": "Konvertierung kameradigitalisierter Filmnegative und Dias",
  "builtin-baseline": "664933b8d385dfc01f4e0cdff4c7c74e71f6a740",
  "dependencies": [
    "gtest",
    "tbb",
    {
      "name": "highway",
      "features": [
        "contrib"
      ]
    }
  ],
  "features": {
    "raw": {
      "description": "RAW-Dekodierung (Adapter libraw)",
      "dependencies": [
        "libraw"
      ]
    },
    "imageio": {
      "description": "Bilddateien lesen und schreiben (Adapter oiio)",
      "dependencies": [
        {
          "name": "openimageio",
          "features": [
            "jpegxl"
          ]
        }
      ]
    },
    "color": {
      "description": "Farbmanagement (Adapter lcms)",
      "dependencies": [
        "lcms"
      ]
    },
    "vision": {
      "description": "Bildanalyse (Adapter opencv)",
      "dependencies": [
        {
          "name": "opencv4",
          "default-features": false
        }
      ]
    },
    "persistence": {
      "description": "JSON-Dateien (Adapter json)",
      "dependencies": [
        "nlohmann-json"
      ]
    },
    "hashing": {
      "description": "Inhaltsprüfsumme (Adapter xxhash)",
      "dependencies": [
        "xxhash"
      ]
    },
    "logging": {
      "description": "Protokoll (Adapter spdlog)",
      "dependencies": [
        "spdlog"
      ]
    },
    "gui": {
      "description": "Oberfläche und Druck (autoneg_ui, Adapter qtprint)",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "gui",
            "widgets",
            "testlib",
            "png",
            "jpeg",
            "freetype",
            "harfbuzz",
            "opengl",
            "doubleconversion",
            "pcre2",
            "thread",
            {
              "name": "fontconfig",
              "platform": "linux"
            },
            {
              "name": "xcb",
              "platform": "linux"
            },
            {
              "name": "xcb-xlib",
              "platform": "linux"
            },
            {
              "name": "xkb",
              "platform": "linux"
            },
            {
              "name": "cups",
              "platform": "linux"
            }
          ]
        }
      ]
    }
  }
}

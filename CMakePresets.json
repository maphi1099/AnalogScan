{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_MANIFEST_FEATURES": "raw;raw-parallel;imageio;color;vision;persistence;hashing;logging;gui",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/ports"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang-cl",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows, clang-cl, Debug",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build/Debug_Win",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-release",
      "displayName": "Windows, clang-cl, Release",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build/Release_Win",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux, clang, Debug",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/Debug_Linux",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-release",
      "displayName": "Linux, clang, Release",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/Release_Linux",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-check",
      "hidden": true,
      "inherits": "linux-base",
      "binaryDir": "$env{HOME}/autoneg-checks/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux, GCC (Kompatibilität, außerhalb von build/)",
      "inherits": "linux-check",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++" }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux, clang, AddressSanitizer + UBSan (außerhalb von build/)",
      "inherits": "linux-check",
      "cacheVariables": { "AUTONEG_SANITIZER": "address" }
    },
    {
      "name": "linux-tsan",
      "displayName": "Linux, clang, ThreadSanitizer (außerhalb von build/)",
      "inherits": "linux-check",
      "cacheVariables": {
        "AUTONEG_SANITIZER": "thread",
        "VCPKG_TARGET_TRIPLET": "x64-linux-tsan",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "VCPKG_MANIFEST_FEATURES": "raw;imageio;color;vision;persistence;hashing;logging",
        "AUTONEG_WITH_GUI": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-gcc", "configurePreset": "linux-gcc" },
    { "name": "linux-asan", "configurePreset": "linux-asan" },
    { "name": "linux-tsan", "configurePreset": "linux-tsan" }
  ],
  "testPresets": [
    { "name": "test-base", "hidden": true, "output": { "outputOnFailure": true } },
    { "name": "windows-debug", "inherits": "test-base", "configurePreset": "windows-debug" },
    { "name": "windows-release", "inherits": "test-base", "configurePreset": "windows-release" },
    { "name": "linux-debug", "inherits": "test-base", "configurePreset": "linux-debug" },
    { "name": "linux-release", "inherits": "test-base", "configurePreset": "linux-release" },
    { "name": "linux-gcc", "inherits": "test-base", "configurePreset": "linux-gcc" },
    { "name": "linux-asan", "inherits": "test-base", "configurePreset": "linux-asan" },
    { "name": "linux-tsan", "inherits": "test-base", "configurePreset": "linux-tsan" }
  ]
}

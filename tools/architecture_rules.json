{
  "description": "Erlaubte Abhängigkeiten laut Architektur 0.3 Kap. 4.3 mit den Anpassungen A-01 bis A-06 und A-09/A-10 (Planning/abweichungen_planung.txt). Module ohne Eintrag in 'foreign' dürfen keine Fremd-Header einbinden.",

  "headerGroups": {
    "libraw":  { "prefixes": ["libraw/"], "exact": ["libraw.h"] },
    "oiio":    { "prefixes": ["OpenImageIO/"] },
    "lcms":    { "exact": ["lcms2.h", "lcms2_plugin.h"] },
    "opencv":  { "prefixes": ["opencv2/", "opencv/"] },
    "json":    { "prefixes": ["nlohmann/"] },
    "xxhash":  { "exact": ["xxhash.h", "xxh3.h", "xxh_x86dispatch.h"] },
    "spdlog":  { "prefixes": ["spdlog/", "fmt/"] },
    "tbb":     { "prefixes": ["tbb/", "oneapi/tbb"], "exact": ["oneapi/tbb.h"] },
    "simd":    { "prefixes": ["hwy/"], "exact": ["Halide.h", "HalideBuffer.h", "HalideRuntime.h", "immintrin.h", "x86intrin.h", "arm_neon.h"] },
    "qt":      { "prefixes": ["QtCore/", "QtGui/", "QtWidgets/", "QtPrintSupport/", "QtTest/", "QtSvg/"], "regex": ["^Q[A-Z][A-Za-z0-9]*$", "^q[a-z0-9_]+\\.h$"] },
    "gtest":   { "prefixes": ["gtest/", "gmock/"] },
    "vulkan":  { "prefixes": ["vulkan/"], "exact": ["volk.h"] },
    "platform": {
      "prefixes": ["sys/"],
      "exact": ["windows.h", "Windows.h", "unistd.h", "fcntl.h", "io.h", "direct.h", "dirent.h", "pthread.h", "process.h", "shlobj.h", "ShlObj.h", "knownfolders.h", "winioctl.h", "tlhelp32.h", "psapi.h", "dlfcn.h", "pwd.h", "sched.h"]
    }
  },

  "modules": {
    "base":            { "layer": "core",        "deps": [] },
    "model":           { "layer": "core",        "deps": ["base"] },
    "image":           { "layer": "core",        "deps": ["base"] },
    "layout":          { "layer": "core",        "deps": ["base", "model"] },
    "ports":           { "layer": "core",        "deps": ["base", "model", "image", "layout"] },
    "pipeline":        { "layer": "core",        "deps": ["base", "model", "image", "ports"] },
    "steps":           { "layer": "core",        "deps": ["base", "model", "image", "ports", "pipeline"] },
    "analysis":        { "layer": "core",        "deps": ["base", "model", "image", "ports"] },
    "application":     { "layer": "application", "deps": ["base", "model", "image", "layout", "ports", "pipeline", "steps", "analysis"] },
    "ui":              { "layer": "ui",          "deps": ["application", "base", "model", "image", "layout", "ports", "pipeline", "steps", "analysis"],
                         "foreign": ["qt"], "externalTargets": ["^Qt6::"] },

    "adapter_libraw":  { "layer": "adapter", "deps": ["base", "model", "image", "ports"], "foreign": ["libraw", "platform"], "externalTargets": ["^libraw::"] },
    "adapter_oiio":    { "layer": "adapter", "deps": ["base", "model", "image", "ports"], "foreign": ["oiio", "platform"], "externalTargets": ["^OpenImageIO::"] },
    "adapter_lcms":    { "layer": "adapter", "deps": ["base", "model", "image", "ports"], "foreign": ["lcms", "platform"], "externalTargets": ["^lcms2::", "^unofficial::lcms2"] },
    "adapter_opencv":  { "layer": "adapter", "deps": ["base", "model", "image", "ports"], "foreign": ["opencv", "platform"], "externalTargets": ["^opencv_"] },
    "adapter_json":    { "layer": "adapter", "deps": ["base", "model", "image", "ports"], "foreign": ["json", "platform"], "externalTargets": ["^nlohmann_json::"] },
    "adapter_xxhash":  { "layer": "adapter", "deps": ["base", "model", "image", "ports"], "foreign": ["xxhash", "platform"], "externalTargets": ["^xxHash::"] },
    "adapter_qtprint": { "layer": "adapter", "deps": ["base", "model", "image", "ports", "layout"], "foreign": ["qt", "platform"], "externalTargets": ["^Qt6::"] },
    "adapter_spdlog":  { "layer": "adapter", "deps": ["base", "model", "image", "ports"], "foreign": ["spdlog", "platform"], "externalTargets": ["^spdlog::", "^fmt::"] },
    "adapter_tbb":     { "layer": "adapter", "deps": ["base", "model", "image", "ports"], "foreign": ["tbb", "platform"], "externalTargets": ["^TBB::"] },
    "backend_cpu":     { "layer": "adapter", "deps": ["base", "model", "image", "ports"], "foreign": ["tbb", "simd", "platform"], "externalTargets": ["^TBB::", "^hwy::", "^Halide::"] },

    "autoneg":         { "layer": "program", "deps": ["*"] }
  },

  "includeRoots": {
    "base": "base/",
    "model": "model/",
    "image": "image/",
    "layout": "layout/",
    "ports": "ports/",
    "pipeline": "pipeline/",
    "steps": "steps/",
    "analysis": "analysis/",
    "application": "application/",
    "ui": "ui/",
    "adapter_libraw": "adapters/libraw/",
    "adapter_oiio": "adapters/oiio/",
    "adapter_lcms": "adapters/lcms/",
    "adapter_opencv": "adapters/opencv/",
    "adapter_json": "adapters/json/",
    "adapter_xxhash": "adapters/xxhash/",
    "adapter_qtprint": "adapters/qtprint/",
    "adapter_spdlog": "adapters/spdlog/",
    "adapter_tbb": "adapters/tbb/",
    "backend_cpu": "backends/cpu/",
    "autoneg": ["autoneg/", "shared/"]
  },

  "tests": {
    "dirs": ["tests"],
    "includeRoots": ["mocks/", "support/", "reference/"],
    "foreign": ["gtest", "platform"],
    "componentDir": "tests/component",
    "componentForeign": "*",
    "foreignDirs": { "tests/unit/ui": ["qt"], "tests/e2e": ["qt"] }
  }
}
